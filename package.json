{
  "name": "chinese-learning-tool",
  "version": "0.1.0",
  "description": "A desktop application for learning Mandarin and Cantonese Chinese with integrated dictionary, flashcards, and spaced repetition.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check-db": "node scripts/check-database.js",
    "tauri:dev": "npm run check-db && cargo tauri dev",
    "tauri:build": "npm run check-db && cargo tauri build",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benburghardt/chinese-learning-tool.git"
  },
  "keywords": [
    "chinese",
    "mandarin",
    "cantonese",
    "learning",
    "flashcards",
    "dictionary",
    "education"
  ],
  "author": "Ben Burghardt",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/benburghardt/chinese-learning-tool/issues"
  },
  "homepage": "https://github.com/benburghardt/chinese-learning-tool#readme",
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.6.2"
  }
}
